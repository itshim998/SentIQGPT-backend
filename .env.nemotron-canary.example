# SentIQ Nemotron Intuitive isolated canary deployment
#
# Use only on a separate canary revision/hostname with zero production traffic.
# Keep every credential in the deployment secret store, never in this file.

NODE_ENV=production
SENTIQ_NEMOTRON_ROLLOUT_STAGE=canary
SENTIQ_NEMOTRON_CANARY_DEPLOYMENT_ID=replace-with-canary-revision-label
SENTIQ_NEMOTRON_FULL_ROLLOUT_ACK=

# This template enables the complete end-to-end canary. The startup preflight
# also permits dependency-safe partial stages and emergency kill-switch states.
SENTIQ_NVIDIA_PROVIDER_ENABLED=true
SENTIQ_NEMOTRON_INTUITIVE_ENABLED=true
SENTIQ_UNIFIED_TEXT_TOKENS_V2_ENABLED=true
SENTIQ_INTUITIVE_QUOTA_UI_ENABLED=true

# Primary provider pool. Add more indexed slots in the deployment secret store.
NVIDIA_API_KEY_1=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
SENTIQ_NVIDIA_MAX_GENERATED_TOKENS=8000
SENTIQ_INTUITIVE_TOTAL_TIMEOUT_MS=120000

# Free-only last-resort fallback pin.
POLLINATIONS_INTUITIVE_MODEL=vendouple/nemotron-3-ultra:free

# Unified guest identity and control database credentials are mandatory.
SENTIQ_ANON_USAGE_HASH_SECRET=
SUPABASE_URL_1=
SUPABASE_SERVICE_ROLE_KEY_1=

# Legacy Python message/token enforcement must remain disabled.
SENTIQ_PYTHON_LLM_QUOTA_ENFORCEMENT=false
