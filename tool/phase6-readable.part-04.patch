diff --git a/mobile/sentiq_chat/lib/core/performance/performance_policy.dart b/mobile/sentiq_chat/lib/core/performance/performance_policy.dart
new file mode 100644
index 0000000..bf7dd48
--- /dev/null
+++ b/mobile/sentiq_chat/lib/core/performance/performance_policy.dart
@@ -0,0 +1,60 @@
+import 'dart:io';
+import 'dart:ui' show ImageFilter;
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter/painting.dart';
+
+/// Centralized Android performance policy for animation, blur and image memory.
+abstract final class SentIQPerformancePolicy {
+  static const bool forceLowPerformance = bool.fromEnvironment(
+    'SENTIQ_LOW_PERFORMANCE',
+    defaultValue: false,
+  );
+
+  static const double maximumBlurSigma = 18;
+  static const int normalImageCacheBytes = 72 * 1024 * 1024;
+  static const int lowImageCacheBytes = 36 * 1024 * 1024;
+
+  static bool get lowPerformanceDevice {
+    if (forceLowPerformance) return true;
+    // Keep tests and developer builds deterministic. The conservative CPU
+    // heuristic is only used by production builds on real Android devices.
+    return kReleaseMode && Platform.isAndroid && Platform.numberOfProcessors <= 4;
+  }
+
+  static bool reduceMotion(BuildContext context) {
+    return MediaQuery.maybeOf(context)?.disableAnimations ??
+        WidgetsBinding.instance.platformDispatcher.accessibilityFeatures
+            .disableAnimations;
+  }
+
+  static bool useLowCostEffects(BuildContext context) {
+    return lowPerformanceDevice || reduceMotion(context);
+  }
+
+  static Duration motionDuration(BuildContext context, Duration requested) {
+    return reduceMotion(context) ? Duration.zero : requested;
+  }
+
+  static ImageFilter? glassFilter(BuildContext context, double requestedSigma) {
+    if (useLowCostEffects(context) || requestedSigma <= 0) return null;
+    final double sigma = requestedSigma.clamp(0, maximumBlurSigma).toDouble();
+    return ImageFilter.blur(sigmaX: sigma, sigmaY: sigma);
+  }
+
+  static int decodedImageWidth(
+    BuildContext context, {
+    int normal = 2048,
+    int low = 1280,
+  }) {
+    return useLowCostEffects(context) ? low : normal;
+  }
+
+  static void configureImageCache() {
+    final ImageCache cache = PaintingBinding.instance.imageCache;
+    final bool low = lowPerformanceDevice;
+    cache.maximumSize = low ? 96 : 180;
+    cache.maximumSizeBytes = low ? lowImageCacheBytes : normalImageCacheBytes;
+  }
+}
diff --git a/mobile/sentiq_chat/lib/core/performance/performance_trace.dart b/mobile/sentiq_chat/lib/core/performance/performance_trace.dart
new file mode 100644
index 0000000..844553e
--- /dev/null
+++ b/mobile/sentiq_chat/lib/core/performance/performance_trace.dart
@@ -0,0 +1,51 @@
+import 'dart:developer' as developer;
+
+import 'package:flutter/scheduler.dart';
+import 'package:flutter/widgets.dart';
+
+/// Opt-in profile markers. There is no production logging cost unless the
+/// `SENTIQ_PERFORMANCE_TRACE` dart define is enabled for a profile build.
+abstract final class SentIQPerformanceTrace {
+  static const bool enabled = bool.fromEnvironment(
+    'SENTIQ_PERFORMANCE_TRACE',
+    defaultValue: false,
+  );
+
+  static final Stopwatch _startup = Stopwatch();
+  static bool _frameTracingInstalled = false;
+
+  static void beginStartup() {
+    if (!enabled) return;
+    _startup
+      ..reset()
+      ..start();
+  }
+
+  static void markFirstFlutterFrame() {
+    if (!enabled) return;
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      _startup.stop();
+      developer.Timeline.instantSync(
+        'sentiq.first_flutter_frame',
+        arguments: <String, Object?>{'elapsed_ms': _startup.elapsedMilliseconds},
+      );
+    });
+  }
+
+  static void installFrameTimingTrace() {
+    if (!enabled || _frameTracingInstalled) return;
+    _frameTracingInstalled = true;
+    SchedulerBinding.instance.addTimingsCallback((List<FrameTiming> timings) {
+      for (final FrameTiming timing in timings) {
+        developer.Timeline.instantSync(
+          'sentiq.frame_timing',
+          arguments: <String, Object?>{
+            'build_us': timing.buildDuration.inMicroseconds,
+            'raster_us': timing.rasterDuration.inMicroseconds,
+            'total_us': timing.totalSpan.inMicroseconds,
+          },
+        );
+      }
+    });
+  }
+}
diff --git a/mobile/sentiq_chat/lib/core/security/safe_external_link.dart b/mobile/sentiq_chat/lib/core/security/safe_external_link.dart
new file mode 100644
index 0000000..fcbe036
--- /dev/null
+++ b/mobile/sentiq_chat/lib/core/security/safe_external_link.dart
@@ -0,0 +1,41 @@
+import 'package:url_launcher/url_launcher.dart';
+
+/// The only boundary allowed to hand an external URI to Android.
+///
+/// User/model supplied links are HTTPS-only, contain no credentials, and open
+/// outside SentIQ Chat. The support-email helper is intentionally separate so
+/// arbitrary `mailto:` values can never enter through rendered content.
+abstract final class SafeExternalLink {
+  static bool isSafeHttps(Uri uri) {
+    return uri.scheme.toLowerCase() == 'https' &&
+        uri.host.isNotEmpty &&
+        uri.userInfo.isEmpty;
+  }
+
+  static Future<bool> openHttps(Object? value) async {
+    final Uri? uri = switch (value) {
+      Uri candidate => candidate,
+      String candidate => Uri.tryParse(candidate.trim()),
+      _ => null,
+    };
+    if (uri == null || !isSafeHttps(uri)) return false;
+    try {
+      return await launchUrl(uri, mode: LaunchMode.externalApplication);
+    } on Object {
+      return false;
+    }
+  }
+
+  static Future<bool> emailSupport() async {
+    final Uri uri = Uri(
+      scheme: 'mailto',
+      path: 'support@sentiqlabs.com',
+      queryParameters: const <String, String>{'subject': 'SentIQ Chat support'},
+    );
+    try {
+      return await launchUrl(uri, mode: LaunchMode.externalApplication);
+    } on Object {
+      return false;
+    }
+  }
+}
diff --git a/mobile/sentiq_chat/lib/core/security/secure_auth_storage.dart b/mobile/sentiq_chat/lib/core/security/secure_auth_storage.dart
new file mode 100644
index 0000000..cfcc919
--- /dev/null
+++ b/mobile/sentiq_chat/lib/core/security/secure_auth_storage.dart
@@ -0,0 +1,32 @@
+import 'package:flutter_secure_storage/flutter_secure_storage.dart';
+import 'package:supabase_flutter/supabase_flutter.dart';
+
+/// Stores the Supabase refresh/session material in Android encrypted storage.
+///
+/// SentIQ Chat has not shipped publicly yet, so there is intentionally no
+/// SharedPreferences migration path: a pre-release install may require one
+/// fresh sign-in instead of retaining a plaintext-at-rest session.
+class SecureAuthStorage extends LocalStorage {
+  SecureAuthStorage({FlutterSecureStorage? storage})
+    : _storage = storage ?? FlutterSecureStorage();
+
+  static const String _sessionKey = 'sentiq.supabase.session.v1';
+
+  final FlutterSecureStorage _storage;
+
+  @override
+  Future<void> initialize() async {}
+
+  @override
+  Future<String?> accessToken() => _storage.read(key: _sessionKey);
+
+  @override
+  Future<bool> hasAccessToken() => _storage.containsKey(key: _sessionKey);
+
+  @override
+  Future<void> persistSession(String persistSessionString) =>
+      _storage.write(key: _sessionKey, value: persistSessionString);
+
+  @override
+  Future<void> removePersistedSession() => _storage.delete(key: _sessionKey);
+}
