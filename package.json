{
  "name": "sentiq-chat",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.backend.json",
    "start": "node dist/backend/server.js",
    "dev": "ts-node --project tsconfig.backend.json backend/server.ts",
    "check:migrations": "ts-node --project tsconfig.backend.json backend/checkShardMigrations.ts",
    "llm-service": "python backend/llm_service.py",
    "dev:all": "concurrently \"npm run dev\" \"npm run llm-service\"",
    "test:pass1": "ts-node --project tsconfig.backend.json backend/testPass1ShardRouter.ts && ts-node --project tsconfig.backend.json backend/testPass1HttpErrors.ts",
    "test:pass2": "ts-node --project tsconfig.backend.json backend/testPass2Auth.ts",
    "test:profile": "ts-node --project tsconfig.backend.json backend/testProfileFlow.ts",
    "test:workspace": "ts-node --project tsconfig.backend.json backend/testWorkspaceContinuity.ts",
    "test:pipeline": "ts-node --project tsconfig.backend.json backend/testPipeline.ts",
    "test:web-search": "ts-node --project tsconfig.backend.json backend/testWebSearch.ts",
    "test:websurf-v2": "ts-node --project tsconfig.backend.json backend/testWebSurfV2.ts",
    "test:websurf-search-intelligence": "ts-node --project tsconfig.backend.json backend/testWebSurfSearchIntelligence.ts",
    "test:websurf-answer-intelligence": "ts-node --project tsconfig.backend.json backend/testWebSurfAnswerIntelligence.ts",
    "test:websurf-presentation": "node backend/testWebSurfPresentation.mjs",
    "test:websurf-v2-persistence": "ts-node --project tsconfig.backend.json backend/testWebSurfV2Persistence.ts",
    "test:deep-research": "ts-node --project tsconfig.backend.json backend/testDeepResearch.ts",
    "test:clarification": "ts-node --project tsconfig.backend.json backend/testIntentClarification.ts",
    "test:improvements": "ts-node --project tsconfig.backend.json backend/testImprovementPlan.ts",
    "test:pass2-reliability": "ts-node --project tsconfig.backend.json backend/testPass2Reliability.ts",
    "test:pass3-memory": "ts-node --project tsconfig.backend.json backend/testPass3MemoryReliability.ts",
    "test:passA": "ts-node --project tsconfig.backend.json backend/testPassABugFixes.ts",
    "test:frontend-bootstrap": "ts-node --project tsconfig.backend.json backend/testFrontendBootstrap.ts",
    "test:live": "ts-node --project tsconfig.backend.json backend/testSentIQLive.ts",
    "test:conversation-sync": "ts-node --project tsconfig.backend.json backend/testConversationSyncState.ts",
    "test:supabase-canonicalization": "ts-node --project tsconfig.backend.json backend/testSupabaseCanonicalization.ts",
    "test:execution-profiles": "ts-node --project tsconfig.backend.json backend/testExecutionProfiles.ts",
    "test:context-budget": "ts-node --project tsconfig.backend.json backend/testContextBudgetManager.ts && ts-node --project tsconfig.backend.json backend/testContextComposition.ts",
    "test:context-capsules": "ts-node --project tsconfig.backend.json backend/testContextCapsules.ts",
    "test:source-retrieval": "ts-node --project tsconfig.backend.json backend/testSourceRetrieval.ts",
    "test:groq-capacity": "python backend/testGroqCapacity.py",
    "test:file-generation": "ts-node --project tsconfig.backend.json backend/testFileGeneration.ts",
    "test:frontend-file-generation": "ts-node --project tsconfig.backend.json backend/testFrontendFileGeneration.ts",
    "test:priority4-contracts": "ts-node --project tsconfig.backend.json backend/testPriority4Contracts.ts",
    "test:phase0": "ts-node --project tsconfig.backend.json backend/testPhase0EmergencyStabilization.ts",
    "test:safety-timeout": "ts-node --project tsconfig.backend.json backend/testSafetyTimeoutPolicy.ts",
    "eval:golden": "ts-node --project tsconfig.backend.json backend/evalGoldenPrompts.ts",
    "billing:seed-plans": "ts-node --project tsconfig.backend.json backend/billing/seedPlans.ts",
    "billing:test-quota": "ts-node --project tsconfig.backend.json backend/billing/testQuota.ts",
    "billing:verify-razorpay-config": "ts-node --project tsconfig.backend.json backend/billing/verifyRazorpayConfig.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.0",
    "@types/pdfkit": "^0.17.6",
    "cors": "^2.8.5",
    "docx": "^9.6.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.1.0",
    "jszip": "^3.10.1",
    "jose": "^6.2.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.33.5",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/helmet": "^0.0.48",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.11.0",
    "concurrently": "^9.0.0",
    "katex": "^0.16.11",
    "marked": "^15.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
