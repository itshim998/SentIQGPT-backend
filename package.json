{
  "name": "sentiq-chat",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.backend.json",
    "start": "node dist/backend/verifyNemotronDeploymentReadiness.js && node dist/backend/server.js",
    "dev": "ts-node --project tsconfig.backend.json backend/verifyNemotronDeploymentReadiness.ts && ts-node --project tsconfig.backend.json backend/server.ts",
    "check:migrations": "ts-node --project tsconfig.backend.json backend/checkShardMigrations.ts",
    "test:migrations": "ts-node --project tsconfig.backend.json backend/testMigrationScopeSeparation.ts",
    "test:lease-retry-regression": "ts-node --project tsconfig.backend.json backend/testGenerationLeaseRetryRegression.ts",
    "test:shards": "ts-node --project tsconfig.backend.json backend/testTwoDataShardTopology.ts",
    "llm-service": "python backend/llm_service.py",
    "dev:all": "concurrently \"npm run dev\" \"npm run llm-service\"",
    "test:pass1": "ts-node --project tsconfig.backend.json backend/testPass1ShardRouter.ts && ts-node --project tsconfig.backend.json backend/testPass1HttpErrors.ts",
    "test:pass2": "ts-node --project tsconfig.backend.json backend/testPass2Auth.ts",
    "test:profile": "ts-node --project tsconfig.backend.json backend/testProfileFlow.ts",
    "test:workspace": "ts-node --project tsconfig.backend.json backend/testWorkspaceContinuity.ts",
    "test:pipeline": "ts-node --project tsconfig.backend.json backend/testPipeline.ts",
    "test:web-search": "ts-node --project tsconfig.backend.json backend/testWebSearch.ts",
    "test:websurf-v2": "ts-node --project tsconfig.backend.json backend/testWebSurfV2.ts",
    "test:websurf-search-intelligence": "ts-node --project tsconfig.backend.json backend/testWebSurfSearchIntelligence.ts",
    "test:websurf-answer-intelligence": "ts-node --project tsconfig.backend.json backend/testWebSurfAnswerIntelligence.ts",
    "test:websurf-presentation": "node backend/testWebSurfPresentation.mjs",
    "test:websurf-v2-persistence": "ts-node --project tsconfig.backend.json backend/testWebSurfV2Persistence.ts",
    "test:deep-research": "ts-node --project tsconfig.backend.json backend/testDeepResearch.ts",
    "test:title-regression": "ts-node --project tsconfig.backend.json backend/testTitleGenerationBug.ts",
    "test:improvements": "ts-node --project tsconfig.backend.json backend/testImprovementPlan.ts",
    "test:pass2-reliability": "ts-node --project tsconfig.backend.json backend/testPass2Reliability.ts",
    "test:pass3-memory": "ts-node --project tsconfig.backend.json backend/testPass3MemoryReliability.ts",
    "test:passA": "ts-node --project tsconfig.backend.json backend/testPassABugFixes.ts",
    "test:frontend-bootstrap": "node scripts/runFrontendBootstrapCheck.mjs",
    "test:frontend-logo-performance": "node --no-warnings frontend/tests/phase9-logo-performance.test.mjs",
    "test:live": "ts-node --project tsconfig.backend.json backend/testSentIQLive.ts",
    "test:conversation-sync": "ts-node --project tsconfig.backend.json backend/testConversationSyncState.ts",
    "test:supabase-canonicalization": "ts-node --project tsconfig.backend.json backend/testSupabaseCanonicalization.ts",
    "test:execution-profiles": "ts-node --project tsconfig.backend.json backend/testExecutionProfiles.ts",
    "test:fast-natural-voice": "ts-node --project tsconfig.backend.json backend/testFastNaturalVoice.ts",
    "test:nemotron-rollout-flags": "ts-node --project tsconfig.backend.json backend/testNemotronRolloutFlags.ts",
    "test:nemotron-provider": "python backend/testPollinationsIntuitiveModelConfig.py && python backend/testPollinationsIntuitiveLive.py && python backend/testNvidiaNemotronProvider.py && python backend/testNemotronRouting.py && ts-node --project tsconfig.backend.json backend/testNemotronIntuitiveLane.ts",
    "test:nemotron-deployment-readiness": "ts-node --project tsconfig.backend.json backend/testNemotronDeploymentReadiness.ts && node scripts/testNemotronCanaryContract.mjs",
    "test:nemotron-production-readiness": "ts-node --project tsconfig.backend.json backend/testUnifiedTextProductionReadiness.ts",
    "verify:nemotron-deployment-readiness": "ts-node --project tsconfig.backend.json backend/verifyNemotronDeploymentReadiness.ts",
    "verify:nemotron-canary-live": "node scripts/verifyNemotronCanaryLive.mjs",
    "test:model-tool-contract": "ts-node --project tsconfig.backend.json backend/testToolContract.ts",
    "test:model-tool-transport": "ts-node --project tsconfig.backend.json backend/testModelToolTransport.ts && python backend/testModelToolProviderTransport.py",
    "test:model-tool-execution": "ts-node --project tsconfig.backend.json backend/testModelToolExecution.ts",
    "test:model-native-lifecycle": "ts-node --project tsconfig.backend.json backend/testModelNativeLifecycle.ts",
    "test:model-capability-routing": "ts-node --project tsconfig.backend.json backend/testModelCapabilityRouting.ts",
    "test:model-tool-configuration": "ts-node --project tsconfig.backend.json backend/testModelToolConfiguration.ts",
    "test:model-memory-safety": "ts-node --project tsconfig.backend.json backend/testModelMemorySafety.ts",
    "test:image-routing-safety": "ts-node --project tsconfig.backend.json backend/testImageRoutingSafety.ts",
    "test:intuitive-image": "ts-node --project tsconfig.backend.json backend/testIntuitiveImageRouting.ts",
    "test:image-input": "ts-node --project tsconfig.backend.json backend/testImageInputLayer1.ts && python backend/testImageInputRotation.py",
    "test:context-budget": "ts-node --project tsconfig.backend.json backend/testContextBudgetManager.ts && ts-node --project tsconfig.backend.json backend/testContextComposition.ts",
    "test:request-budget-lifecycle": "ts-node --project tsconfig.backend.json backend/testRequestBudgetLifecycle.ts",
    "test:stream-lifecycle": "ts-node --project tsconfig.backend.json backend/testStreamDisconnectLifecycle.ts",
    "test:protected-context-safety": "ts-node --project tsconfig.backend.json backend/testProtectedContextSafety.ts",
    "test:context-capsules": "ts-node --project tsconfig.backend.json backend/testContextCapsules.ts",
    "test:source-retrieval": "ts-node --project tsconfig.backend.json backend/testSourceRetrieval.ts",
    "test:groq-capacity": "python backend/testGroqCapacity.py",
    "test:file-generation": "ts-node --project tsconfig.backend.json backend/testFileGeneration.ts",
    "test:frontend-file-generation": "ts-node --project tsconfig.backend.json backend/testFrontendFileGeneration.ts",
    "test:frontend-tool-lifecycle": "node frontend/tests/tool-lifecycle-reducer.test.mjs",
    "test:frontend-billing": "node --no-warnings frontend/tests/billing-token-usage.test.mjs && node --no-warnings frontend/tests/guest-experience.test.mjs",
    "test:frontend-ui-state": "node scripts/runFrontendUiStateTests.mjs",
    "test:quota-ui-contract": "ts-node --project tsconfig.backend.json backend/billing/testQuotaUiExposure.ts && node --no-warnings frontend/tests/text-quota-state.test.mjs && node --no-warnings frontend/tests/text-quota-controller-contract.test.mjs",
    "test:frontend": "node scripts/runFrontendChecks.mjs",
    "check:frontend-syntax": "node scripts/checkFrontendSyntax.mjs",
    "test:azure-container-renderer": "node scripts/testAzureContainerAppScaling.mjs",
    "test:nemotron-azure-rollout": "node scripts/testNemotronFullRolloutUpdate.mjs && node scripts/testNemotronAzureRolloutIntegrity.mjs",
    "verify:model-native-executors-live": "ts-node --project tsconfig.backend.json backend/verifyModelNativeExecutors.ts",
    "verify:model-native-memory-migration-live": "node scripts/verifyAutomaticMemoryMigrationLive.mjs",
    "verify:model-native-stack-startup-live": "node scripts/verifyModelNativeStackStartupLive.mjs",
    "verify:model-native-chat-pipeline-live": "node scripts/verifyModelNativeChatPipelineLive.mjs",
    "verify:model-native-tools": "node scripts/verifyModelNativeTools.mjs",
    "test:priority4-contracts": "ts-node --project tsconfig.backend.json backend/testPriority4Contracts.ts",
    "test:phase0": "ts-node --project tsconfig.backend.json backend/testPhase0EmergencyStabilization.ts",
    "test:safety-timeout": "ts-node --project tsconfig.backend.json backend/testSafetyTimeoutPolicy.ts",
    "eval:golden": "ts-node --project tsconfig.backend.json backend/evalGoldenPrompts.ts",
    "eval:natural-voice": "ts-node --project tsconfig.backend.json backend/evalNaturalVoiceQuality.ts",
    "eval:natural-voice:live": "ts-node --project tsconfig.backend.json backend/evalLiveNaturalVoice.ts",
    "billing:seed-plans": "ts-node --project tsconfig.backend.json backend/billing/seedPlans.ts",
    "billing:test-quota": "ts-node --project tsconfig.backend.json backend/billing/testQuota.ts && ts-node --project tsconfig.backend.json backend/billing/testGuestTextTrial.ts",
    "billing:test-token-allowances": "ts-node --project tsconfig.backend.json backend/billing/testTokenAllowances.ts && node --no-warnings frontend/tests/billing-token-usage.test.mjs",
    "billing:test-unified-text-v2": "ts-node --project tsconfig.backend.json backend/billing/testUnifiedTextTokensV2.ts && ts-node --project tsconfig.backend.json backend/billing/testUnifiedTextUsageSummary.ts",
    "billing:test-unified-text-v2-sql": "ts-node --project tsconfig.backend.json backend/billing/testUnifiedTextMigrationContract.ts && ts-node --project tsconfig.backend.json backend/billing/testUnifiedTextTokensV2Sql.ts",
    "billing:test-unified-text-pass51-sql": "ts-node --project tsconfig.backend.json backend/billing/testUnifiedTextPass51Sql.ts",
    "billing:test-unified-text-full-rollout-sql": "ts-node --project tsconfig.backend.json backend/billing/testUnifiedTextFullRolloutSql.ts",
    "test:unified-text-routing": "ts-node --project tsconfig.backend.json backend/billing/testUnifiedTextRoutePolicy.ts",
    "billing:verify-razorpay-config": "ts-node --project tsconfig.backend.json backend/billing/verifyRazorpayConfig.ts",
    "test:generation-distributed": "ts-node --project tsconfig.backend.json backend/testGenerationDistributedIntegration.ts",
    "test:production-closure": "ts-node --project tsconfig.backend.json backend/testProductionRuntimeClosure.ts",
    "test:sse-http2-regression": "ts-node --project tsconfig.backend.json backend/testHttp2SseHeadersRegression.ts",
    "test:guest-turn-robustness": "ts-node --project tsconfig.backend.json backend/testGuestTextTurnRobustness.ts && node --no-warnings frontend/tests/guest-turn-robustness.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.0",
    "@types/pg": "^8.23.1",
    "cors": "^2.8.5",
    "docx": "^9.6.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.2",
    "jszip": "^3.10.1",
    "marked": "^15.0.7",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "pg": "^8.23.0",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.33.5",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.12",
    "@types/pdfkit": "^0.17.6",
    "concurrently": "^9.0.0",
    "katex": "^0.16.11",
    "puppeteer-core": "^25.12.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
