# SentIQ Chat v1 — Environment Configuration
# Copy this file to .env and fill in your keys.

# --- Gemini / Gemma Free-Tier Fallback Pool ---
# Prefer GEMINI_API_KEY_1..6 for six distinct Google AI Studio projects.
# GEMINI_API_KEY remains supported as a legacy alias for slot 1.
GEMINI_API_KEY=AQ.Ab8RN6KDI8X8x0muR_0HaNMkdUnV_zC4kiZ3nu8gBeg4sR39CQ
GEMINI_API_KEY_1=AQ.Ab8RN6KDI8X8x0muR_0HaNMkdUnV_zC4kiZ3nu8gBeg4sR39CQ
GEMINI_API_KEY_2=AQ.Ab8RN6LVW3xfoDMyb4FiXRCr0AGaIP31PC0GADVUEPpi84wOEA
GEMINI_API_KEY_3=AQ.Ab8RN6IUmZyxJSIx4zjj-Tcp1ot6ovDjPLpPcePIRdldFTUzsw
GEMINI_API_KEY_4=AQ.Ab8RN6JIteK8p8glKHTqAe91eT2fuEtZKJyt84o1739LTsAlmw
GEMINI_API_KEY_5=AQ.Ab8RN6IKS6lbBuLoxTAe3KZVUBPu0hoKJieP0tZhpziLYbGfmQ
GEMINI_API_KEY_6=AQ.Ab8RN6K4uZ-CTO2AuBfw8248hCSwVA-u8W4LRVSHMwCSuU7r9g
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_STANDARD_MODEL=gemini-3.1-flash-lite
GEMINI_LITE_MODEL=gemini-3.1-flash-lite
GEMMA_PRIMARY_MODEL=gemma-4-31b-it
GEMMA_SECONDARY_MODEL=gemma-4-26b-a4b-it
GEMINI_REASONING_MODEL=gemini-3.5-flash
GEMINI_REASONING_BACKUP_MODEL=gemini-3-flash
GEMINI_WEB_MODEL=gemini-2.5-flash-lite
GEMINI_WEB_BACKUP_MODEL=gemini-2.5-flash
GEMINI_GOOGLE_SEARCH_ENABLED=true
GEMINI_TIMEOUT_MS=30000
GEMINI_KEY_COOLDOWN_MS=60000
GEMINI_429_COOLDOWN_MS=300000
GEMINI_INVALID_KEY_DISABLE=true
GEMINI_HIGH_THINKING_BUDGET=8192
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
SMART_MODEL_CODING=qwen-coder
SMART_MODEL_LIGHTWEIGHT=gpt-5-nano

# --- Groq (Cognitive Tasks Model) ---
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_CHAT_MODEL=openai/gpt-oss-120b
MASTER_ROUTER_ENABLED=true
MASTER_ROUTER_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
MASTER_ROUTER_TIMEOUT_MS=3500


# --- Image Generation (Pollinations / Flux) ---
# FLUX_API_KEY is optional — Pollinations works on free tier without it.
# Set this for premium/priority access to Flux Schnell, FLUX.2 Dev, Z-Image Turbo.
POLLINATIONS_API_KEY=
FLUX_API_KEY=
POLLINATIONS_OPENAI_ENDPOINT=https://gen.pollinations.ai/v1/chat/completions
POLLINATIONS_TIMEOUT_OPENAI_LARGE=180
POLLINATIONS_STREAM_FIRST_CHUNK_TIMEOUT_OPENAI_LARGE=120
POLLINATIONS_STREAM_IDLE_TIMEOUT_OPENAI_LARGE=120
# Safety defaults for production. Input safety timeouts degrade open only for
# low-risk text chat/title calls; tool/file/image/memory tasks remain strict.
# Output safety timeouts after text has streamed are logged and completed
# gracefully, while explicit unsafe classifications are still blocked.
SAFETY_TIMEOUT=3
SAFETY_OUTPUT_TIMEOUT=5
SAFETY_BUFFER_SIZE=75
HUGGINGFACE_API_TOKEN=
STABILITY_API_KEY=

# --- Server ---
PORT=3001
LLM_SERVICE_PORT=3002
LLM_SERVICE_HOST=127.0.0.1
LLM_SERVICE_URL=http://127.0.0.1:3002
SENTIQ_INTERNAL_SERVICE_TOKEN=
SENTIQ_ENABLE_UNSAFE_INTERNAL_ENDPOINTS=false
# Canonical public frontend origin first, followed by local development origins.
CORS_ORIGINS=https://sentiqchat.sentiqlabs.com,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5173

# --- Supabase Multi-DB Router ---
SUPABASE_URL_1=
SUPABASE_SERVICE_ROLE_KEY_1=
SUPABASE_URL_2=
SUPABASE_SERVICE_ROLE_KEY_2=
SUPABASE_URL_3=
SUPABASE_SERVICE_ROLE_KEY_3=
SUPABASE_URL_4=
SUPABASE_SERVICE_ROLE_KEY_4=
SENTIQ_IMAGE_STORAGE_DB=1
SENTIQ_IMAGE_STORAGE_BUCKET=sentiq-images
SENTIQ_GENERATED_FILE_STORAGE_DB=1
SENTIQ_GENERATED_FILE_STORAGE_BUCKET=sentiq-generated-files
SENTIQ_GENERATED_FILE_STORAGE_LIMIT_BYTES=26214400
SENTIQ_JSON_BODY_LIMIT=6mb
# --- JWT Secret ---
SUPABASE_JWT_SECRET=

# --- Rate Limiting ---
SENTIQ_RPM=120

# --- Billing, Quotas, And Payments ---
# disabled keeps the app bootable without payment credentials. Use manual for admin grants.
# Razorpay activation requires all Razorpay keys and plan ids below.
SENTIQ_BILLING_MODE=disabled
SENTIQ_BILLING_CURRENCY=INR
SENTIQ_BILLING_ADMIN_EMAILS=
SENTIQ_BILLING_ALLOW_PERMANENT_MANUAL_GRANTS=false
SENTIQ_ANON_USAGE_HASH_SECRET=
SENTIQ_PLAN_STUDENT_CORE_PRICE_PAISE=9900
SENTIQ_PLAN_PREMIUM_PRICE_PAISE=24900
SENTIQ_PLAN_PRO_PRICE_PAISE=54900
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STUDENT_CORE=
RAZORPAY_PLAN_PREMIUM=
RAZORPAY_PLAN_PRO=
SENTIQ_MODEL_PREMIUM_TEXT=groq:gpt-oss-120b
SENTIQ_MODEL_LITE_TEXT=gemini:gemini-lite
SENTIQ_MODEL_ADVANCED_REASONING=groq:gpt-oss-120b
SENTIQ_IMAGE_MODEL_NORMAL=pollinations:zimage
SENTIQ_IMAGE_MODEL_TEXT_CORE=pollinations:gptimage
SENTIQ_IMAGE_MODEL_TEXT_PREMIUM=pollinations:gptimage-large
SENTIQ_PYTHON_LLM_QUOTA_ENFORCEMENT=false

# --- Cache ---
SENTIQ_CACHE_FILE=sentiq_cache.db

# --- Math Pipeline ---
# Set to "true" to enable two-model verification (openai-large + Gemini).
# Default: disabled (openai-large only — lower latency).
ENABLE_MATH_VERIFICATION=false

# --- Tavily Web Search ---
# Comma-separated list of Tavily API keys for round-robin rotation.
# Get your keys at https://tavily.com
TAVILY_KEYS=
