# SentIQ Chat v1 — Environment Configuration
# Copy this file to .env and fill in your keys.

# --- Gemini (Reasoning Model) ---
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
SMART_MODEL_CODING=qwen-coder
SMART_MODEL_LIGHTWEIGHT=gpt-5-nano

# --- Groq (Cognitive Tasks Model) ---
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_CHAT_MODEL=openai/gpt-oss-120b
MASTER_ROUTER_ENABLED=true
MASTER_ROUTER_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
MASTER_ROUTER_TIMEOUT_MS=3500


# --- Image Generation (Pollinations / Flux) ---
# FLUX_API_KEY is optional — Pollinations works on free tier without it.
# Set this for premium/priority access to Flux Schnell, FLUX.2 Dev, Z-Image Turbo.
POLLINATIONS_API_KEY=
FLUX_API_KEY=
POLLINATIONS_OPENAI_ENDPOINT=https://gen.pollinations.ai/v1/chat/completions
POLLINATIONS_TIMEOUT_OPENAI_LARGE=180
POLLINATIONS_STREAM_FIRST_CHUNK_TIMEOUT_OPENAI_LARGE=120
POLLINATIONS_STREAM_IDLE_TIMEOUT_OPENAI_LARGE=120
HUGGINGFACE_API_TOKEN=
STABILITY_API_KEY=

# --- Server ---
PORT=3001
LLM_SERVICE_PORT=3002
LLM_SERVICE_HOST=127.0.0.1
LLM_SERVICE_URL=http://127.0.0.1:3002
SENTIQ_INTERNAL_SERVICE_TOKEN=
SENTIQ_ENABLE_UNSAFE_INTERNAL_ENDPOINTS=false
# Canonical public frontend origin first. Keep legacy origins temporarily for old sessions, OAuth redirects, and cached clients.
CORS_ORIGINS=https://sentiqchat.sentiqlabs.com,https://sentiqgpt.sentiqlabs.com,https://www.sentiqgpt.sentiqlabs.com,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5173

# --- Supabase Multi-DB Router ---
SUPABASE_URL_1=
SUPABASE_SERVICE_ROLE_KEY_1=
SUPABASE_URL_2=
SUPABASE_SERVICE_ROLE_KEY_2=
SUPABASE_URL_3=
SUPABASE_SERVICE_ROLE_KEY_3=
SUPABASE_URL_4=
SUPABASE_SERVICE_ROLE_KEY_4=
SENTIQ_IMAGE_STORAGE_DB=1
SENTIQ_IMAGE_STORAGE_BUCKET=sentiq-images
SENTIQ_GENERATED_FILE_STORAGE_DB=1
SENTIQ_GENERATED_FILE_STORAGE_BUCKET=sentiq-generated-files
SENTIQ_GENERATED_FILE_STORAGE_LIMIT_BYTES=26214400
SENTIQ_JSON_BODY_LIMIT=6mb
# --- JWT Secret ---
SUPABASE_JWT_SECRET=

# --- Rate Limiting ---
SENTIQ_RPM=120

# --- Billing, Quotas, And Payments ---
# disabled keeps the app bootable without payment credentials. Use manual for admin grants.
# Razorpay activation requires all Razorpay keys and plan ids below.
SENTIQ_BILLING_MODE=disabled
SENTIQ_BILLING_CURRENCY=INR
SENTIQ_BILLING_ADMIN_EMAILS=
SENTIQ_BILLING_ALLOW_PERMANENT_MANUAL_GRANTS=false
SENTIQ_ANON_USAGE_HASH_SECRET=
SENTIQ_PLAN_STUDENT_CORE_PRICE_PAISE=9900
SENTIQ_PLAN_PREMIUM_PRICE_PAISE=24900
SENTIQ_PLAN_PRO_PRICE_PAISE=54900
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STUDENT_CORE=
RAZORPAY_PLAN_PREMIUM=
RAZORPAY_PLAN_PRO=
SENTIQ_MODEL_PREMIUM_TEXT=groq:gpt-oss-120b
SENTIQ_MODEL_LITE_TEXT=pollinations:llama-scout
SENTIQ_MODEL_ADVANCED_REASONING=pollinations:openai-large
SENTIQ_IMAGE_MODEL_NORMAL=pollinations:zimage
SENTIQ_IMAGE_MODEL_TEXT_CORE=pollinations:gptimage
SENTIQ_IMAGE_MODEL_TEXT_PREMIUM=pollinations:gptimage-large
SENTIQ_PYTHON_LLM_QUOTA_ENFORCEMENT=false

# --- Cache ---
SENTIQ_CACHE_FILE=sentiq_cache.db

# --- Math Pipeline ---
# Set to "true" to enable two-model verification (openai-large + Gemini).
# Default: disabled (openai-large only — lower latency).
ENABLE_MATH_VERIFICATION=false

# --- Tavily Web Search ---
# Comma-separated list of Tavily API keys for round-robin rotation.
# Get your keys at https://tavily.com
TAVILY_KEYS=
