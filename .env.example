# SentIQGPT v1 — Environment Configuration
# Copy this file to .env and fill in your keys.

# --- Gemini (Reasoning Model) ---
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
SMART_MODEL_CODING=qwen-coder
SMART_MODEL_LIGHTWEIGHT=gpt-5-nano

# --- Groq (Cognitive Tasks Model) ---
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Image Generation (Pollinations / Flux) ---
# FLUX_API_KEY is optional — Pollinations works on free tier without it.
# Set this for premium/priority access to Flux Schnell, FLUX.2 Dev, Z-Image Turbo.
POLLINATIONS_API_KEY=
FLUX_API_KEY=
POLLINATIONS_OPENAI_ENDPOINT=https://gen.pollinations.ai/v1/chat/completions
HUGGINGFACE_API_TOKEN=
STABILITY_API_KEY=

# --- Server ---
PORT=3001
LLM_SERVICE_PORT=3002
CORS_ORIGINS=https://sentiqgpt.sentiqlabs.com,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5173

# --- Rate Limiting ---
SENTIQ_RPM=120

# --- Cache ---
SENTIQ_CACHE_FILE=sentiq_cache.db
