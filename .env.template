SENTIQ_LIVE_PREMIUM_MAX_SESSION_SECONDS=600
SENTIQ_LIVE_PRO_MAX_SESSION_SECONDS=600
SENTIQ_LIVE_STUDENT_CORE_MAX_ACTIVE=1
SENTIQ_LIVE_PREMIUM_MAX_ACTIVE=1
SENTIQ_LIVE_PRO_MAX_ACTIVE=2
SENTIQ_LIVE_GLOBAL_MAX_ACTIVE=
SENTIQ_LIVE_PROJECT_MAX_ACTIVE=
