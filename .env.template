# --- NVIDIA Nemotron Intuitive rollout (dormant until explicitly enabled) ---
# Keep real credentials only in the untracked local .env or deployment secret store.
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_API_KEY_4=
NVIDIA_API_KEY_5=
NVIDIA_API_KEY_6=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Verified Pollinations reasoning fallback route for Intuitive mode.
POLLINATIONS_INTUITIVE_MODEL=deepseek
SENTIQ_NVIDIA_MAX_GENERATED_TOKENS=8000
SENTIQ_FREE_FAST_ORDINARY_CONTEXT_TOKENS=3200
SENTIQ_FREE_FAST_COMPLEX_CONTEXT_TOKENS=4000
SENTIQ_FREE_INTUITIVE_ORDINARY_CONTEXT_TOKENS=6000
SENTIQ_FREE_INTUITIVE_COMPLEX_CONTEXT_TOKENS=8000
SENTIQ_INTUITIVE_ORDINARY_MAX_GENERATED_TOKENS=6000
SENTIQ_INTUITIVE_ORDINARY_REASONING_BUDGET=2000
SENTIQ_INTUITIVE_ORDINARY_MIN_FINAL_ANSWER_TOKENS=1500
SENTIQ_INTUITIVE_COMPLEX_MAX_GENERATED_TOKENS=8000
SENTIQ_INTUITIVE_COMPLEX_REASONING_BUDGET=3500
SENTIQ_INTUITIVE_COMPLEX_MIN_FINAL_ANSWER_TOKENS=2000
SENTIQ_INTUITIVE_TOTAL_TIMEOUT_MS=120000
