# Independent kill switches. All default off so current production behaviour is unchanged.
SENTIQ_NVIDIA_PROVIDER_ENABLED=false
SENTIQ_NEMOTRON_INTUITIVE_ENABLED=false
SENTIQ_UNIFIED_TEXT_TOKENS_V2_ENABLED=false
SENTIQ_INTUITIVE_QUOTA_UI_ENABLED=false
# Deployment preflight stage. Keep off unless using the isolated canary procedure.
SENTIQ_NEMOTRON_ROLLOUT_STAGE=off
SENTIQ_NEMOTRON_CANARY_DEPLOYMENT_ID=
SENTIQ_NEMOTRON_FULL_ROLLOUT_ACK=

# Model-native SentIQ tool transport and execution flags (all default off).
SENTIQ_MODEL_TOOL_REGISTRY_ENABLED=false
SENTIQ_MODEL_CHART_SELECTION_ENABLED=false
SENTIQ_MODEL_FILE_SELECTION_ENABLED=false
SENTIQ_MODEL_MEMORY_SELECTION_ENABLED=false
SENTIQ_GROQ_TOOL_TRANSPORT_ENABLED=false
SENTIQ_GEMINI_TOOL_TRANSPORT_ENABLED=false
SENTIQ_POLLINATIONS_TOOL_TRANSPORT_ENABLED=true
SENTIQ_MODEL_TOOL_DIAGNOSTICS_ENABLED=false
SENTIQ_MODEL_WEBSURF_SELECTION_ENABLED=false
SENTIQ_MODEL_IMAGE_SELECTION_ENABLED=false

# --- Image Generation (Pollinations) ---
# POLLINATIONS_API_KEY is preferred. FLUX_API_KEY remains a legacy credential alias.
# Plan-tier image routing is code-owned; prompt-category image model variables are ignored.
POLLINATIONS_API_KEY=
FLUX_API_KEY=
POLLINATIONS_OPENAI_ENDPOINT=https://gen.pollinations.ai/v1/chat/completions
# Safety defaults for production. Input safety timeouts degrade open only for
# low-risk text chat/title calls; tool/file/image/memory tasks remain strict.
# Output safety timeouts after text has streamed are logged and completed
# gracefully, while explicit unsafe classifications are still blocked.
SAFETY_TIMEOUT=3
SAFETY_OUTPUT_TIMEOUT=5
SAFETY_BUFFER_SIZE=75
HUGGINGFACE_API_TOKEN=
STABILITY_API_KEY=

# --- Server ---
PORT=3001
LLM_SERVICE_PORT=3002
LLM_SERVICE_HOST=127.0.0.1
LLM_SERVICE_URL=http://127.0.0.1:3002
SENTIQ_INTERNAL_SERVICE_TOKEN=
SENTIQ_ENABLE_UNSAFE_INTERNAL_ENDPOINTS=false
# Canonical public frontend origin first, followed by local development origins.
CORS_ORIGINS=https://sentiqchat.sentiqlabs.com,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5173

# --- Azure Container Apps Deployment Scaling ---
# These non-secret values are consumed by the deployment workflow and Deep Research scale guard.
SENTIQ_CONTAINER_MIN_REPLICAS=0
SENTIQ_CONTAINER_MAX_REPLICAS=1
SENTIQ_CONTAINER_COOLDOWN_SECONDS=900

