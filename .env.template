GEMINI_TIMEOUT_MS=30000
GEMINI_KEY_COOLDOWN_MS=60000
GEMINI_429_COOLDOWN_MS=300000
GEMINI_INVALID_KEY_DISABLE=true
GEMINI_HIGH_THINKING_BUDGET=8192

# --- SentIQ Live Beta (audio-only; long-lived keys remain server-side) ---
SENTIQ_LIVE_ENABLED=false
SENTIQ_LIVE_MODEL=gemini-3.1-flash-live-preview
SENTIQ_LIVE_DEFAULT_VOICE=Kore
SENTIQ_LIVE_SESSION_MAX_SECONDS=600
